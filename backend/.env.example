# =============================================================================
# SupplyLens Environment Configuration Specification
# Production-ready environment template for Vercel, Backend (FastAPI), and Supabase
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Realtime Configuration
# -----------------------------------------------------------------------------
# Public Supabase API URL and Anon Key (safe for browser consumption)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase Service Role Key (NEVER expose to frontend / client-side)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection string for Prisma / SQLAlchemy migrations
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# 2. Frontend / Next.js Vercel Deployment
# -----------------------------------------------------------------------------
# Base URL for the SupplyLens FastAPI Backend
NEXT_PUBLIC_API_BASE_URL=https://api.supplylens.com
# For local development: http://localhost:8000

# Geoapify Geocoding & Mapping API
NEXT_PUBLIC_GEOAPIFY_API_KEY=your-geoapify-api-key

# Razorpay Standard Checkout Client Key (Public Key ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# -----------------------------------------------------------------------------
# 3. Backend Commercial Monetization & Payment Gateways (5% Success Fee)
# -----------------------------------------------------------------------------
# Razorpay Credentials (Secret must NEVER be committed or exposed to frontend)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cashfree Backup Gateway (Optional)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENVIRONMENT=SANDBOX

# SupplyLens Monetization Defaults
DEFAULT_SUCCESS_FEE_RATE=0.05
FEE_POLICY_VERSION=2026-v1.0

# -----------------------------------------------------------------------------
# 4. Multi-Model AI Routing & Grounded Intelligence
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GROK_API_KEY=your-grok-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# -----------------------------------------------------------------------------
# 5. Data Extraction & Web Intelligence
# -----------------------------------------------------------------------------
NIMBLEWAY_API_KEY=your-nimbleway-api-key
NIMBLE_API_KEY=your-nimbleway-api-key
APIFY_API_KEY=your-apify-api-key
APIFY_API_TOKEN=your-apify-api-token
APIFY_WEBSITE_CRAWLER_ACTOR_ID=apify/website-content-crawler
APIFY_SUPPLIER_SEARCH_ACTOR_ID=apify/website-content-crawler
APIFY_CONTACT_EXTRACTION_ACTOR_ID=apify/website-content-crawler
CODERABBIT_API_KEY=your-coderabbit-api-key

# -----------------------------------------------------------------------------
# 6. Usage & Budget Controls
# -----------------------------------------------------------------------------
AI_DAILY_TOKEN_BUDGET=500000
NIMBLE_DAILY_REQUEST_BUDGET=500
APIFY_DAILY_RUN_BUDGET=100
MAX_PAGES_PER_SUPPLIER=5
MAX_SUPPLIER_DISCOVERY_RESULTS=10

